# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# IMPORTANT: the token that is currently hardcoded in the legacy firsd.py must
# be revoked and reissued with @BotFather before this repository is made public.
# Treat it as compromised the moment the repo is shared.

# From @BotFather.
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The public channel the alerts go to. Channel ids are negative.
CHAT_ID=-1000000000000

# Where failures are reported. Must NOT be the public channel — set it to your
# own user id. If this is left empty the bot refuses to post errors publicly and
# only writes them to the log.
OPERATOR_CHAT_ID=

# Send early-warning messages for Yeela requests that have no licence yet.
REPORT_PENDING=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
